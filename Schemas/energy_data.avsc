    { "name": "OnshoreWindMWh", "type": ["null", "double"], "default": null },
    { "name": "ThermalPowerMWh", "type": ["null", "double"], "default": null },

    { "name": "timestamp", "type": "string", "doc": "SQL Style Timestamp" },
    { "name": "date", "type": "string" },
    { "name": "hour", "type": "int" },
