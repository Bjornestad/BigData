{
  "name": "hdfs-sink-weather-raw-avro",
  "config": {
    "connector.class": "io.confluent.connect.hdfs.HdfsSinkConnector",
    "topics.dir": "/user/hive/warehouse",
    "flush.size": "5",
    "tasks.max": "1",
    "timezone": "UTC",
    "hive.database": "default",
    "rotate.interval.ms": "60000",
    "hive.partition.field.name": "year,month",
    "locale": "en-US",
    "logs.dir": "/tmp/logs",
    "format.class": "io.confluent.connect.hdfs.parquet.ParquetFormat",
    "hive.integration": "true",
    "hive.conf.dir": "/etc/hive",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "errors.log.enable": "true",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "partition.duration.ms": "2678400000",
    "schema.compatibility": "BACKWARD",
    "topics": "weather_raw_avro",
    "parquet.codec": "snappy",
    "hdfs.url": "hdfs://namenode:9000",
    "hive.metastore.uris": "thrift://hive-metastore:9083",
    "value.converter.schema.registry.url": "http://kafka-schema-registry:8081",
    "consumer.override.auto.offset.reset": "latest",
    "partitioner.class": "io.confluent.connect.storage.partitioner.TimeBasedPartitioner",
    "name": "hdfs-sink-weather-raw-avro",
    "errors.tolerance": "all",
    "path.format": "'year'=YYYY/'month'=M",
    "timestamp.extractor": "Wallclock"
  }
}
