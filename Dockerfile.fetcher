FROM python:3.12-slim

# Install Java headless and wget (needed for Hadoop)
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-21-jre-headless \
    wget \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Download and install Hadoop client
RUN wget -q https://archive.apache.org/dist/hadoop/common/hadoop-3.3.6/hadoop-3.3.6.tar.gz && \
    tar -xzf hadoop-3.3.6.tar.gz -C /opt/ && \
    rm hadoop-3.3.6.tar.gz

# Set Hadoop environment variables
ENV HADOOP_HOME=/opt/hadoop-3.3.6
ENV PATH=$HADOOP_HOME/bin:$PATH
ENV JAVA_HOME=/usr/lib/jvm/default-java
ENV PYTHONUNBUFFERED=1

# Install Python dependencies
RUN pip install --no-cache-dir requests pandas pyarrow

# Create scripts directory
RUN mkdir -p /scripts

WORKDIR /app
